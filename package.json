        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@typescript-eslint/utils": "^8.70.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "obsidian": "^1.13.1",
        "tslib": "2.4.0",
        "typescript": "^4.9.5",
        "typescript-eslint": "^8.70.0"
    },
    "dependencies": {
